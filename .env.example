# ==============================================================================
# CONFIGURATION CLOUDFLARE R2 (EXEMPLE LOCAL)
# Renseigner vos identifiants réels dans votre fichier local .env (ignoré par Git)
# ==============================================================================

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_ENDPOINT=

R2_MEDIA_BUCKET=psyavocat-media
R2_DOCUMENTS_BUCKET=psyavocat-documents

R2_PRESIGNED_EXPIRATION=15

# ==============================================================================
# BASE DE DONNÉES (secrets locaux)
# ==============================================================================
DB_URL=jdbc:mysql://localhost:3306/psyavocat_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# FIREBASE (compte de service Admin SDK) ET ADMINISTRATEUR INITIAL
# ==============================================================================
FIREBASE_CREDENTIALS_PATH=
PSYAVOCAT_ADMIN_BOOTSTRAP=true
PSYAVOCAT_ADMIN_FIREBASE_UID=
PSYAVOCAT_ADMIN_EMAIL=

# ==============================================================================
# VISIOCONFÉRENCE (serveur Jitsi Meet des rendez-vous en visio)
# ==============================================================================
VISIO_URL=https://meet.ffmuc.net
